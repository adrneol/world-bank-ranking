{
  "name": "worldbank-india-gdp-ranking-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend: World Bank WDI ingestion, country universe filtering, ranking + YoY engines for India's GDP per capita and Total GDP.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "ingest": "node src/scripts/ingest.js",
    "audit:live": "node src/scripts/liveAudit.js",
    "snapshot:create": "node src/scripts/createSnapshot.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "express": "^5.1.0",
    "cors": "^2.8.5"
  }
}