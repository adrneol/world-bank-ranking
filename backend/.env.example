# ============================================================
# World Bank WDI configuration
# ============================================================
# The World Bank Indicators API is OPEN and requires NO API KEY.
# There is deliberately no key/token variable here.

WORLD_BANK_API_BASE_URL=https://api.worldbank.org/v2

# --- Subject: GDP PER CAPITA — the four primary indicators (do not substitute) ---
# Nominal GDP per capita, current US$
WORLD_BANK_NOMINAL_CURRENT_INDICATOR=NY.GDP.PCAP.CD
# Nominal GDP per capita, constant 2015 US$
WORLD_BANK_NOMINAL_CONSTANT_INDICATOR=NY.GDP.PCAP.KD
# GDP per capita PPP, current international $
WORLD_BANK_PPP_CURRENT_INDICATOR=NY.GDP.PCAP.PP.CD
# GDP per capita PPP, constant 2021 international $
WORLD_BANK_PPP_CONSTANT_INDICATOR=NY.GDP.PCAP.PP.KD

# --- Subject: TOTAL GDP — four additional verified raw series (do not substitute) ---
# Total GDP, current price, current US$
WORLD_BANK_TOTAL_CURRENT_INDICATOR=NY.GDP.MKTP.CD
# Total GDP, constant price (real GDP), constant 2015 US$
WORLD_BANK_TOTAL_CONSTANT_INDICATOR=NY.GDP.MKTP.KD
# Total GDP, PPP, current international $
WORLD_BANK_TOTAL_PPP_CURRENT_INDICATOR=NY.GDP.MKTP.PP.CD
# Total GDP, PPP, constant price, constant 2021 international $
WORLD_BANK_TOTAL_PPP_CONSTANT_INDICATOR=NY.GDP.MKTP.PP.KD

# --- Subject: PRICES — CPI inflation (rate), CPI index, GDP-deflator inflation ---
# CPI inflation, annual % (rate; changes are percentage points, never relative %)
WORLD_BANK_INFLATION_CPI_INDICATOR=FP.CPI.TOTL.ZG
# CPI index, 2010 = 100 (index; movement is index points, never percentage points)
WORLD_BANK_INFLATION_CPI_INDEX_INDICATOR=FP.CPI.TOTL
# GDP-deflator inflation, annual % (whole-economy price change)
WORLD_BANK_INFLATION_DEFLATOR_INDICATOR=NY.GDP.DEFL.KD.ZG

# --- Subject: TRADE — current-US$ goods-and-services flows ---
# Exports of goods and services, current US$
WORLD_BANK_EXPORTS_CURRENT_INDICATOR=NE.EXP.GNFS.CD
# Imports of goods and services, current US$
WORLD_BANK_IMPORTS_CURRENT_INDICATOR=NE.IMP.GNFS.CD

# --- Subject: CAPITAL FLOWS — signed FDI level + official FDI/GDP ratio ---
# FDI net inflows, BoP current US$ (signed flow: may be zero/negative)
WORLD_BANK_FDI_INFLOWS_INDICATOR=BX.KLT.DINV.CD.WD
# FDI net inflows, % of GDP (World Bank ratio; changes are percentage points)
WORLD_BANK_FDI_INFLOWS_PCT_GDP_INDICATOR=BX.KLT.DINV.WD.GD.ZS

# --- Subject: EXCHANGE RATES — official LCU-per-USD rate ---
# Official exchange rate, LCU per US$ period average (rise = depreciation)
WORLD_BANK_FX_OFFICIAL_INDICATOR=PA.NUS.FCRF

# --- Subject: EXTERNAL SECTOR — signed flows, reserve stock, remittances ---
# Current account balance, BoP current US$ (signed flow)
WORLD_BANK_CURRENT_ACCOUNT_INDICATOR=BN.CAB.XOKA.CD
# Total reserves minus gold, current US$ (stock level)
WORLD_BANK_RESERVES_EX_GOLD_INDICATOR=FI.RES.XGLD.CD
# Personal remittances received, current US$
WORLD_BANK_REMITTANCES_RECEIVED_INDICATOR=BX.TRF.PWKR.CD.DT

# --- Subject: POPULATION — midyear de-facto headcount ---
# Population, total
WORLD_BANK_POPULATION_TOTAL_INDICATOR=SP.POP.TOTL

# --- Defaults ---
# Default ANALYSIS range (UI default view; the year selector itself is always
# derived from actually stored World Bank years, never from these values).
DEFAULT_START_YEAR=2000
DEFAULT_END_YEAR=2025

# Default INGESTION range (what a refresh fetches without explicit years).
# Reaches the earliest relevant World Bank observations; only actually returned
# raw observations are stored, so per-metric coverage is preserved.
INGEST_START_YEAR=1960
# Defaults to the current calendar year when unset, so newly published World
# Bank years are picked up automatically (leave unset for dynamic behavior).
#INGEST_END_YEAR=2026

# Persistent cache freshness window (hours)
CACHE_TTL_HOURS=24

# Default number of neighbours shown above and below India
RANK_NEIGHBORS_DEFAULT=5

# --- Manual refresh protection ---
# Bearer token required by POST /api/data/refresh when set. Leave empty for
# local development. PRODUCTION MUST SET THIS or the server refuses to start.
# The token is never logged and never appears in API responses.
#REFRESH_ADMIN_TOKEN=

# Allowed CORS origins, comma-separated, exact match (no wildcards).
# Unset means the permissive development default. PRODUCTION MUST SET THIS
# or the server refuses to start (a blanket "*" policy is not acceptable).
#CORS_ORIGINS=https://your-frontend.example,http://localhost:5173

# Abuse protection for manual refresh only (GET ranking/data endpoints are
# never rate-limited): at most this many POST /api/data/refresh attempts per
# client IP per window. Non-positive values disable the limiter.
REFRESH_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_WINDOW_MS=60000

# --- Server ---
PORT=3001

# SQLite database file (relative paths resolve against backend/)
DATABASE_FILE=data/worldbank.db

# --- Database backend (Phase 6A: Turso Cloud primary, local SQLite fallback) ---
# Turso is selected automatically whenever TURSO_DATABASE_URL is set; otherwise
# the local SQLite file above is used. DB_MODE forces the choice explicitly
# ('turso' or 'local'; empty = automatic). Secrets are never logged or
# returned by any endpoint — do not commit real values (use deployment
# environment variables in production).
# LOCAL DEVELOPMENT: set DB_MODE=local below so ordinary dev servers, CLI
# ingests, manual refreshes and TTL triggers can never read or write the
# production Turso database, even when Turso credentials are present in this
# file for controlled manual testing.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
# DB_MODE=local
# Guarded local fallback: when the Turso primary is unreachable at boot AND a
# valid non-empty local database exists, serve from it (with a loud warning)
# instead of failing. Never masks an outage with an empty database, and never
# triggers a full seed merely because local is empty. Production default is
# safe to leave enabled: Render's ephemeral disk holds no local file, so an
# unreachable Turso degrades explicitly instead of seeding.
# ALLOW_LOCAL_DB_FALLBACK=true

# --- World Bank client tuning ---
WB_PER_PAGE=20000
WB_MAX_RETRIES=5
WB_RETRY_BASE_MS=500
WB_TIMEOUT_MS=30000

# Set to 1 to ingest from the live World Bank API on boot when the
# database is empty. Set to 0 to require an explicit refresh call.
WB_AUTO_INGEST_ON_EMPTY=1

# Set to 1 (default) to trigger a background refresh automatically when the
# cache is stale per CACHE_TTL_HOURS. Fresh-cache requests never refresh.
# Set to 0 to refresh only manually via POST /api/data/refresh.
WB_AUTO_REFRESH_ON_STALE=1

# Default-country geolocation (Phase 3 UX default only, never analytical).
# GET /api/geo/country resolves the requester's ISO3 through this keyless
# provider ({ip} is replaced with the client IP) and validates it against
# stored World Bank country metadata. Any failure resolves to null and the
# frontend keeps its fallback country. Empty disables provider lookups.
GEO_PROVIDER_URL=https://ipwho.is/{ip}?fields=country_code
# Single-attempt bound for one geolocation provider call (no retries: slow
# providers fail fast to the fallback instead of delaying the bootstrap).
GEO_TIMEOUT_MS=3000