# ============================================================
# World Bank WDI configuration
# ============================================================
# The World Bank Indicators API is OPEN and requires NO API KEY.
# There is deliberately no key/token variable here.

WORLD_BANK_API_BASE_URL=https://api.worldbank.org/v2

# --- Subject: GDP PER CAPITA — the four primary indicators (do not substitute) ---
# Nominal GDP per capita, current US$
WORLD_BANK_NOMINAL_CURRENT_INDICATOR=NY.GDP.PCAP.CD
# Nominal GDP per capita, constant 2015 US$
WORLD_BANK_NOMINAL_CONSTANT_INDICATOR=NY.GDP.PCAP.KD
# GDP per capita PPP, current international $
WORLD_BANK_PPP_CURRENT_INDICATOR=NY.GDP.PCAP.PP.CD
# GDP per capita PPP, constant 2021 international $
WORLD_BANK_PPP_CONSTANT_INDICATOR=NY.GDP.PCAP.PP.KD

# --- Subject: TOTAL GDP — four additional verified raw series (do not substitute) ---
# Total GDP, current price, current US$
WORLD_BANK_TOTAL_CURRENT_INDICATOR=NY.GDP.MKTP.CD
# Total GDP, constant price (real GDP), constant 2015 US$
WORLD_BANK_TOTAL_CONSTANT_INDICATOR=NY.GDP.MKTP.KD
# Total GDP, PPP, current international $
WORLD_BANK_TOTAL_PPP_CURRENT_INDICATOR=NY.GDP.MKTP.PP.CD
# Total GDP, PPP, constant price, constant 2021 international $
WORLD_BANK_TOTAL_PPP_CONSTANT_INDICATOR=NY.GDP.MKTP.PP.KD

# --- Defaults ---
# Default ANALYSIS range (UI default view; the year selector itself is always
# derived from actually stored World Bank years, never from these values).
DEFAULT_START_YEAR=2000
DEFAULT_END_YEAR=2025

# Default INGESTION range (what a refresh fetches without explicit years).
# Reaches the earliest relevant World Bank observations; only actually returned
# raw observations are stored, so per-metric coverage is preserved.
INGEST_START_YEAR=1960
# Defaults to the current calendar year when unset, so newly published World
# Bank years are picked up automatically (leave unset for dynamic behavior).
#INGEST_END_YEAR=2026

# Persistent cache freshness window (hours)
CACHE_TTL_HOURS=24

# Default number of neighbours shown above and below India
RANK_NEIGHBORS_DEFAULT=5

# --- Manual refresh protection ---
# Bearer token required by POST /api/data/refresh when set. Leave empty for
# local development. PRODUCTION MUST SET THIS or the server refuses to start.
# The token is never logged and never appears in API responses.
#REFRESH_ADMIN_TOKEN=

# Allowed CORS origins, comma-separated, exact match (no wildcards).
# Unset means the permissive development default. PRODUCTION MUST SET THIS
# or the server refuses to start (a blanket "*" policy is not acceptable).
#CORS_ORIGINS=https://your-frontend.example,http://localhost:5173

# Abuse protection for manual refresh only (GET ranking/data endpoints are
# never rate-limited): at most this many POST /api/data/refresh attempts per
# client IP per window. Non-positive values disable the limiter.
REFRESH_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_WINDOW_MS=60000

# --- Server ---
PORT=3001

# SQLite database file (relative paths resolve against backend/)
DATABASE_FILE=data/worldbank.db

# --- World Bank client tuning ---
WB_PER_PAGE=20000
WB_MAX_RETRIES=5
WB_RETRY_BASE_MS=500
WB_TIMEOUT_MS=30000

# Set to 1 to ingest from the live World Bank API on boot when the
# database is empty. Set to 0 to require an explicit refresh call.
WB_AUTO_INGEST_ON_EMPTY=1

# Set to 1 (default) to trigger a background refresh automatically when the
# cache is stale per CACHE_TTL_HOURS. Fresh-cache requests never refresh.
# Set to 0 to refresh only manually via POST /api/data/refresh.
WB_AUTO_REFRESH_ON_STALE=1