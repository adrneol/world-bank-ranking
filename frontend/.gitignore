# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Vite mode env files (non-local flavors are NOT covered by *.local above).
# frontend/.env.development stays tracked intentionally (it pins the dev
# proxy default); frontend/.env.example stays tracked (documented defaults).
# Never commit real hostnames: deployment URLs belong in the hosting
# environment (e.g. Vercel), not in files.
.env.production
.env.staging
.env.test
.env.preview

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
