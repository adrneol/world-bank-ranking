# Base URL of the ranking backend (no trailing slash).
# This is PUBLIC configuration: VITE_* variables are exposed to the browser,
# so never put secrets (API keys, passwords, tokens) here.
#
# Production/API deployment URL (documentation placeholder — not a real host):
#   VITE_API_BASE_URL=https://your-backend.example.com
#
# A local (untracked, ignored) frontend/.env may hold the real deployment URL
# for convenience (public, safe). `vite dev` still uses the local backend:
# the tracked frontend/.env.development pins VITE_API_BASE_URL to empty in
# development mode (it beats frontend/.env), so the browser calls relative
# `/api/...`, which the Vite dev proxy forwards to the local backend (see
# vite.config.js, default http://localhost:3001). A personal
# frontend/.env.local override is optional and also untracked.
# Deployed environments (e.g. Vercel Preview and Production) provide the real
# VITE_API_BASE_URL as an environment variable, which always takes precedence
# over any file. To build locally against a deployed backend instead, either
# set the OS environment variable for one command or temporarily move
# frontend/.env.local aside — never commit a real hostname.
VITE_API_BASE_URL=https://your-backend.example.com

# --- Public site display metadata (optional; safe to commit) ---
# Shown on the About page (and Home footer line). DISPLAY ONLY: these never
# drive WDI vintage, latest year, availability, or freshness — those always
# come from the backend. Leave any value empty for its neutral fallback.
# Author / role shown on About (empty = "author details not specified").
VITE_SITE_AUTHOR_NAME=
VITE_SITE_AUTHOR_ROLE=
# SITE UPDATE DATE (manual developer-maintained value).
# Represents the site's own product/content update date: change these parts
# whenever the application/site itself is intentionally updated.
# This date is NOT the WDI vintage, NOT the local retrieval timestamp, and
# must NOT automatically change when World Bank data refreshes.
# Shown on About as "Site update date". Parts are optional and compose
# gracefully (empty parts are omitted, e.g. year-only renders "2026",
# year+month renders "July 2026").
VITE_SITE_LAST_UPDATED_YEAR=
VITE_SITE_LAST_UPDATED_MONTH=
VITE_SITE_LAST_UPDATED_DAY=
# REFERENCE DATA VINTAGE (normally leave BOTH empty → automatic mode).
# Empty (recommended default): the About page obtains the authoritative
# current World Bank WDI vintage dynamically from the backend/API at
# runtime, so a newer WDI release appears without editing these values
# and without rebuilding the frontend.
# Override (only when intentional): fill BOTH values to show a fixed
# reference vintage (e.g. November 2025). This override is informational
# public-site metadata only — it does not change the actual WDI data.
# Partial configuration (only one of the two filled) is invalid: the
# application ignores it and uses the automatic value instead.
# Do NOT update these values every month unless a fixed override is desired.
VITE_SITE_DATA_YEAR=
VITE_SITE_DATA_MONTH=
# Public dataset name shown beside provenance lines.
VITE_SITE_SOURCE_NAME=World Bank WDI
# Public contact email shown on the About page (Contact section).
# DISPLAY ONLY and never a secret — leave empty to omit the section address.
VITE_SITE_CONTACT_EMAIL=
