# Base URL of the ranking backend (no trailing slash).
# This is PUBLIC configuration: VITE_* variables are exposed to the browser,
# so never put secrets (API keys, passwords, tokens) here.
#
# Production/API deployment URL (documentation placeholder — not a real host):
#   VITE_API_BASE_URL=https://your-backend.example.com
#
# A local frontend/.env may hold the real deployment URL for convenience
# (public, safe, and untracked). Local development overrides it with an empty
# value in frontend/.env.local (also untracked), so `vite dev` calls relative
# `/api/...`, which the Vite dev proxy forwards to the local backend (see
# vite.config.js, default http://localhost:3001). Deployed environments
# (e.g. Vercel Preview and Production) provide the real VITE_API_BASE_URL as
# an environment variable, which always takes precedence over any file.
VITE_API_BASE_URL=https://your-backend.example.com
