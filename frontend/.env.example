# Base URL of the ranking backend (no trailing slash).
# This is PUBLIC configuration: VITE_* variables are exposed to the browser,
# so never put secrets (API keys, passwords, tokens) here.
#
# Production/API deployment URL:
#   VITE_API_BASE_URL=https://world-bank-ranking.onrender.com
#
# A local (untracked, ignored) frontend/.env may hold that production value
# (public, safe) so plain builds default to it.
# Local development overrides it with an empty value in frontend/.env.local
# (also untracked and ignored),
# so `vite dev` calls relative `/api/...`, which the Vite dev proxy forwards
# to the local backend (see vite.config.js, default http://localhost:3001).
# Vercel deployments set VITE_API_BASE_URL as a real environment variable,
# which always takes precedence over any file.
VITE_API_BASE_URL=https://world-bank-ranking.onrender.com
